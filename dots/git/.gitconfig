[user]
    name = Luke Rigby
    email = 109941713+rigs-dub@users.noreply.github.com

[color]
    ui = true

[init]
    defaultBranch = main

[alias]
    a = add
    aa = add -A
    ap = add -p
    s = status
    pr = pull -r
    pu = push
    ca = commit --amend
    cm = commit -m
    c = commit
    co = checkout
    cob = checkout -b
    d = diff
    r = rebase
    rs = restore --staged
    who = blame
    st = stash
    stu = stash -u
    stp = stash pop

[push]
    autoSetupRemote = true

[core]
    ignoreCase = false
